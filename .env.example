# Copy to .env and fill in what you want. .env is git-ignored and never served to the browser.
# EVERYTHING BELOW IS OPTIONAL. With no keys, Save Tokens runs fully offline: analysis, scoring,
# local optimization, comparison and cost estimates all work, and token counts are labelled "estimated".

# ---- Exact token counts for Claude models (Anthropic count_tokens API; free, rate-limited) ----
ANTHROPIC_API_KEY=
# Models offered for exact counting, comma-separated; the first is the default. A count is valid only for the model you pick.
# ANTHROPIC_COUNT_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5,claude-fable-5-1
# Run `npm run verify:live` after setting the key to check it against the real API.

# ---- Optional AI rewriting: Improve with AI (only runs when you click it) ----
# Google Gemini free tier. NOTE: on the free tier Google may use prompts and responses to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Ollama: runs on your machine, no key. Install Ollama, pull a model, then name it here.
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Hugging Face Inference Providers (small free monthly credit). Needs BOTH a token and a model.
HF_TOKEN=
# HF_MODEL=openai/gpt-oss-120b:fireworks-ai
# Run `npm run verify:live -- --rewrite` to check the providers you configured.

# ---- Server ----
# HOST stays on loopback by default because the server holds your keys.
# HOST=127.0.0.1
# PORT=5173
# ALLOWED_HOSTS=            # extra Host header names, comma-separated (default: localhost, 127.0.0.1, [::1])

# ---- Limits ----
# COUNT_MAX_CHARS=100000    COUNT_RATE_PER_MIN=30    COUNT_TIMEOUT_MS=10000
# REWRITE_MAX_CHARS=20000   REWRITE_RATE_PER_MIN=10  REWRITE_TIMEOUT_MS=30000
